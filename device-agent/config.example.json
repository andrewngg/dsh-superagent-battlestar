{
  "name": "书房工作站",
  "kind": "dsh",
  "platform": "windows",
  "tags": ["书房", "夜间可跑"],
  "models": [
    {
      "id": "deepseek-chat",
      "provider": "deepseek",
      "contextWindow": 128000,
      "strengths": ["code", "reasoning", "writing"],
      "available": true
    },
    {
      "id": "deepseek-reasoner",
      "provider": "deepseek",
      "contextWindow": 128000,
      "strengths": ["reasoning", "math"],
      "available": true
    }
  ],
  "profiles": [
    {
      "id": "desktop",
      "name": "DSH Desktop",
      "plugins": ["@deepseek-ai/dsh-web-app", "@deepseek-ai/dsh-base"]
    }
  ],
  "gateways": [
    {
      "id": "openai-gateway",
      "kind": "openai-compatible",
      "baseUrl": "http://127.0.0.1:8787/v1",
      "models": ["gpt-4o-mini"]
    }
  ],
  "skills": [
    { "id": "office-docx", "name": "Word 文档", "version": "1.0.0" },
    { "id": "office-xlsx", "name": "Excel 表格", "version": "1.0.0" },
    { "id": "web-research", "name": "联网调研", "version": "1.0.0" }
  ],
  "resources": { "cpuCores": 16, "memoryGB": 32, "gpu": "RTX 4070", "os": "Windows 11" },
  "limits": { "maxConcurrentTasks": 2 },
  "executor": {
    "type": "simulate",
    "simulate": {
      "minDurationMs": 2000,
      "maxDurationMs": 6000,
      "minSteps": 3,
      "maxSteps": 6
    },
    "dsh-cli": {
      "command": "dsh run --print {instruction}",
      "timeoutMs": 300000,
      "maxOutputChars": 16000
    },
    "shell": {
      "command": "echo {instruction}",
      "timeoutMs": 60000,
      "maxOutputChars": 8000
    },
    "http": {
      "url": "http://127.0.0.1:7788/execute",
      "timeoutMs": 120000
    },
    "ollama": {
      "baseUrl": "http://127.0.0.1:11434",
      "model": "qwen2.5",
      "timeoutMs": 180000
    }
  },
  "discovery": {
    "dsh": true,
    "ollama": true,
    "gateway": true,
    "skills": true
  }
}
