      "promptNodeId": "6",
      "negativeNodeId": "7",
      "negativePrompt": "blurry, low quality, watermark, text",
      "seedNodeId": "3",
      "outputDir": "C:/Users/you/super-butler-worker/comfyui-out",
      "timeoutMs": 900000,
      "pollMs": 1500,
      "maxImages": 8
    }
  },
  "discovery": { "dsh": false, "ollama": false, "gateway": false, "skills": false }
}
