  "resources": {
    "cpuCores": 12,
    "memoryGB": 32,
    "gpu": "NVIDIA GeForce RTX 3060 12GB",
    "os": "Windows 11"
  },
  "limits": { "maxConcurrentTasks": 1 },
  "executor": {
    "type": "cli",
