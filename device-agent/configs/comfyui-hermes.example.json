      "available": true
    },
    {
      "id": "minimax-h3",
      "provider": "comfyui",
      "strengths": ["video", "audio", "text-to-video", "reference-to-video"],
      "available": true
    }
  ],
  "profiles": [
    {
      "id": "hermes",
      "name": "Hermes + comfyui-workflow",
      "plugins": ["comfyui", "theodore-director", "minimax-h3"]
    }
  ],
  "gateways": [
    {
      "id": "comfyui",
      "kind": "comfyui",
      "baseUrl": "http://127.0.0.1:8188",
      "models": ["comfyui", "minimax-h3"]
    }
  ],
  "skills": [
    { "id": "comfyui-workflow", "name": "ComfyUI 工作流执行", "version": "1.0.0" },
    { "id": "image-generation", "name": "文生图 / 图生图", "version": "1.0.0" },
    { "id": "video-generation", "name": "文生视频 / 参考图生视频", "version": "1.0.0" },
    { "id": "director-multishot", "name": "多分镜连续生成", "version": "1.0.0" }
