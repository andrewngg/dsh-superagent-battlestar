<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.superbutler.app"
    android:versionCode="8"
    android:versionName="0.1.7">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <!-- 家庭内网 HTTP Hub 需要网络；usesCleartextTraffic 允许明文 http -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 14+ 常驻通知改用 specialUse 类型（dataSync 在 Android 15 有 6 小时/24 小时上限，超时会崩溃） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 重启/应用更新后重排提醒闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 精确闹钟：Android 12+ 为特殊权限，可能被用户撤销；代码里会 canScheduleExactAlarms() 判断并回退 non-exact -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            specialUse：常驻状态通知需要长期运行（展示任务进度/在线设备），
            不适合 dataSync —— Android 15 会对 dataSync 前台服务强制 6 小时/24 小时超时，
            超时后未 stopSelf 会被系统以 RemoteServiceException 杀死进程（0.1.2 崩溃即此原因）。
            Android 29-33 没有 specialUse 常量，运行时回退 dataSync（旧系统无此超时限制）。
        -->
        <service
            android:name=".ButlerNotificationService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="BattleStar 常驻状态通知：本地轮询家庭 Hub 快照，展示任务进度与在线/待命设备数" />
        </service>

        <!-- 提醒闹钟接收器：只由应用内 AlarmManager 的显式 PendingIntent 触发 -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- 大脑决策通知的选项按钮：只由本应用通知里的 PendingIntent 触发 -->
        <receiver
            android:name=".DecisionActionReceiver"
            android:exported="false" />

        <!-- 开机/应用更新后从 SharedPreferences 重排提醒闹钟 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
