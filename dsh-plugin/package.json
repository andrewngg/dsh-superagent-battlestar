{
  "name": "@local/dsh-super-butler",
  "version": "0.1.0",
  "private": true,
  "description": "BattleStar：在 DSH 里管理多设备管家 Hub、私人账号/模型密钥与控制台面板",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/client-module.test.mjs test/client-render.test.mjs test/status-route.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
